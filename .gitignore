# Local git checkpoints: track our source, docs, tests and text evidence only.
# The firmware image, vendor libraries, toolchain, Ghidra projects and build
# trees stay on disk but out of history (they are large, and AGENTS.md forbids
# redistributing firmware/libraries or private key material).

# Firmware dump, NAND extract, Ghidra projects, toolchain, disassembly caches
/artifacts/dumps/
/artifacts/workbench/

# Partition/recovery images and other binary payloads
/artifacts/payload/
*.ubifs
*.img
*.img.gz

# Vendor libraries fetched from the firmware (`make vendor`)
/openaurora/vendor/

# Owner root-payload work trees and keys (docs/reproduce/root-payload.md).
# These contain the TV's /conf, vendor settings DB, dropbear and private keys.
/.venv/
/conf/
/conf-ubi/
/hook/
/verify/
/verify-orig/
/remote.txt
/owner_ed25519
/owner_ed25519.pub
/my-hook.sh
/hostkey_*
/authorized_keys
/dropbear
/settingsDB.db
/settingsDBBackup.db
/hook.meta
/verify.meta
/conf.meta
/verify-orig.meta

# Build trees (build, build-tv, build-tv-v2/v3 and the dated sanitizer/lab variants)
/openaurora/build*/

# Crash captures and build archives
*.core
*.tar
*.tar.gz

# Third-party manuals and vendor binary profiles
/artifacts/manuals/
*.bin

# Editor and OS noise
*.swp
*~
.DS_Store

# Raw recorder intermediates; PNG captures are the maintained evidence.
artifacts/analysis/**/offline-apps-grid-*.rgba

# Locally imported native UI artwork (licence/permission varies; not redistributed)
openaurora/ui/*.rgba
